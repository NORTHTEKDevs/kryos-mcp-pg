{
  "_comment": "Append-only audit log + read-only context tables. Agent can write events but cannot read them back (cover-tracks defense).",

  "connection": { "url_env": "DATABASE_URL" },

  "limits": {
    "statement_timeout_ms": 5000,
    "max_rows": 1000,
    "max_query_bytes": 16384
  },

  "tables": [
    {
      "name": "users",
      "actions": ["read"],
      "columns": ["id", "email", "name"],
      "filter": "deleted_at IS NULL"
    },
    {
      "name": "audit_log",
      "actions": ["write"],
      "columns": ["actor", "event", "payload", "created_at"]
    }
  ],

  "ddl": { "allowed": false },
  "shape": {
    "deny_select_star": true,
    "require_where_on_writes": true,
    "allow_window": false
  }
}
